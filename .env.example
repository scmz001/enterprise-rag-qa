# ============================================================
# 复制本文件为 .env，然后按本机 LM Studio 的实际情况填写
# （.env 已被 .gitignore 忽略，不会上传到 git）
# ============================================================

# LM Studio 本地服务地址（LM Studio 中开启 Local Server 后的默认地址）
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# LM Studio 不校验密钥，保留占位值即可
LM_STUDIO_API_KEY=lm-studio

# 对话模型名：填 LM Studio 里已加载的模型标识（可在 Local Server 页面看到）
CHAT_MODEL=请填写你在LM Studio中加载的对话模型名

# 向量化模型名：填 LM Studio 里已加载的 embedding 模型标识
EMBEDDING_MODEL=请填写你在LM Studio中加载的向量模型名
